# Secrets / local env (keep .env.example tracked)
.env
.env.*
!.env.example

# Python dependencies & test artifacts
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
test-results/
allure-results/
allure-report/
.artifacts/

# Browser Use state (profile may contain cookies / tokens)
.local/browser-profile/
.local/seed-meta/

# Knowledge refresh candidates (local until explicitly promoted)
.cursor/skills/domains/*/knowledge/candidate/

# Coverage caches
coverage/
.nyc_output/

# Local caches / temporary files
.local/
.cache/
tmp/
temp/
*.tmp
*.temp

# IDE / OS local files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local seed / debug noise
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cursor/debug-*.log
debug-*.log

# Generated case catalogs
.local/generated-cases/
