# SiliconFlow (OpenAI-compatible; never commit real secrets)
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Browser Use / internal application
E2E_LOGIN_URL=
E2E_HOME_URL=
E2E_RULE_URL=
E2E_RECORD_URL=
E2E_JOB_TRIGGER_URL_TEMPLATE=
E2E_HEADLESS=0
E2E_BROWSER_PROFILE=.local/browser-profile
E2E_ARTIFACT_DIR=.artifacts
E2E_ALLOWED_HOSTS=

# Optional credentials used only by the target application's login flow
E2E_USER=
E2E_PASSWORD=
E2E_CAPTCHA=123456

# Business facts database. Mutating commands require E2E_DB_ENV=test.
E2E_DB_HOST=
E2E_DB_PORT=3306
E2E_DB_NAME=
E2E_DB_USER=
E2E_DB_PASSWORD=
E2E_DB_ENV=test

# Seed runtime metadata is local and atomic.
E2E_META_STORE=file
E2E_META_DIR=.local/seed-meta
E2E_SEED_CLEANUP_POLICY=always
