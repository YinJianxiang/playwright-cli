E2E_USER=your_username
E2E_PASSWORD=your_password
E2E_CAPTCHA=123456

# UI / Job 完整地址。切换内网环境时只修改这里，活动代码禁止硬编码 host 或路径。
E2E_LOGIN_URL=
E2E_HOME_URL=
E2E_RULE_URL=
E2E_RECORD_URL=
# 必须保留 {{rule_id}} 占位符，运行时替换为实际规则 ID。
E2E_JOB_TRIGGER_URL_TEMPLATE=

# 无头：E2E_HEADLESS=1（未设或 0 → 有头）
# E2E_HEADLESS=1

# DB（造数 / ui-flow-db，见 .cursor/skills/ui-flow-db/env-db.md）
E2E_DB_HOST=your_host
E2E_DB_PORT=3306
E2E_DB_NAME=your_database
E2E_DB_USER=your_user
E2E_DB_PASSWORD=your_password
E2E_DB_ENV=test
E2E_META_DB_NAME=e2e_seed_meta
E2E_META_DB_HOST=127.0.0.1
E2E_META_DB_PORT=3306
E2E_META_DB_USER=root
E2E_META_DB_PASSWORD=

# Seed V3 执行结束后的事实数据清理策略：
# always（默认）：无论用例成功或失败都自动清理，适合 CI 和常规回归。
# manual：保留事实数据供本地排查；运行结束会输出 runId、manifest 和手动清理命令。
# CI 环境禁止 manual。临时覆盖也可使用 CLI 参数 --cleanupPolicy=manual。
E2E_SEED_CLEANUP_POLICY=always
