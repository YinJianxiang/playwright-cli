{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ad Control Knowledge Entry",
  "type": "object",
  "required": ["id", "name", "status", "confirmedAt", "evidenceRefs"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["verified", "unknown", "deprecated"] },
    "confirmedAt": { "type": "string", "minLength": 1 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
